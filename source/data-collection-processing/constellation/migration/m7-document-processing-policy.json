{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::data-collection-059416028963-us-east-1-an/research-data/operations/federal-register/*",
        "arn:aws:s3:::data-collection-059416028963-us-east-1-an/research-data/operations/nist-robotics/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::data-collection-059416028963-us-east-1-an",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "research-data/operations/federal-register/*",
            "research-data/operations/nist-robotics/*"
          ]
        }
      }
    }
  ]
}
