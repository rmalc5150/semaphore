{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DedicatedWorkerRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:PutRolePolicy"
      ],
      "Resource": "arn:aws:iam::059416028963:role/constellation-backfill-worker"
    },
    {
      "Sid": "DedicatedWorkerProfile",
      "Effect": "Allow",
      "Action": [
        "iam:CreateInstanceProfile",
        "iam:GetInstanceProfile",
        "iam:AddRoleToInstanceProfile"
      ],
      "Resource": [
        "arn:aws:iam::059416028963:role/constellation-backfill-worker",
        "arn:aws:iam::059416028963:instance-profile/constellation-backfill-worker"
      ]
    },
    {
      "Sid": "WorkerSSMOnly",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy"
      ],
      "Resource": "arn:aws:iam::059416028963:role/constellation-backfill-worker",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
        }
      }
    },
    {
      "Sid": "PassDedicatedWorkerRole",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::059416028963:role/constellation-backfill-worker",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    }
  ]
}
