[Unit]
Description=Bounded Europe PMC full-text discover
After=network-online.target
[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/opt/constellation/source
ExecStart=/opt/constellation/legacy-venv/bin/python -B epmc_fulltext_capture.py --mode discover
Slice=constellation-workers.slice
MemoryMax=402653184
MemorySwapMax=0
CPUQuota=20%
TimeoutStartSec=300
Environment=CONSTELLATION_SHARED_HTTP_LIMITS=1
Environment=CONSTELLATION_ROLE=worker
