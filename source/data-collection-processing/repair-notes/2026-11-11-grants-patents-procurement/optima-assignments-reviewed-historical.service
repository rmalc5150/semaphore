[Unit]
Description=Bounded USPTO assignments historical capture using existing controller access
After=network-online.target
[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/home/ec2-user/data-collection-processing
ExecStart=/home/ec2-user/data-collection-processing/.venv-athena/bin/python -B grants_review_capture.py --sources uspto_assignment_histories --mode historical --universe config/crossref-resumed-universe.json
Slice=optima-financial.slice
MemoryMax=268435456
MemorySwapMax=0
CPUQuota=15%
TimeoutStartSec=250
