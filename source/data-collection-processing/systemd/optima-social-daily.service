[Unit]
Description=Bounded daily Bluesky search/access checks
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/home/ec2-user/data-collection-processing
Slice=optima-data.slice
MemoryAccounting=true
MemoryHigh=402653184
MemoryMax=536870912
MemorySwapMax=0
Environment=ARROW_NUM_THREADS=1
Environment=MALLOC_ARENA_MAX=2
Environment=OPTIMA_HEAVY_LOCK_HELD=1
ExecStart=/usr/bin/flock --exclusive --timeout 21600 --conflict-exit-code 75 /home/ec2-user/data-collection-processing/.heavy-job.lock /usr/bin/timeout --signal=INT --kill-after=120s 35m /home/ec2-user/data-collection-processing/.venv-athena/bin/python -B /home/ec2-user/data-collection-processing/people_social_collection.py --social-only
TimeoutStartSec=7h
TimeoutStopSec=120
KillSignal=SIGINT
SuccessExitStatus=0 1 2 75
Nice=15
