[Unit]
Description=S65 daily RDS product search attention, geographic interest and visible domains
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/home/ec2-user/data-collection-processing
Slice=optima-data.slice
MemoryAccounting=true
MemoryHigh=201326592
MemoryMax=268435456
MemorySwapMax=0
CPUQuota=40%
Environment=ARROW_NUM_THREADS=1
Environment=MALLOC_ARENA_MAX=2
ExecStart=/usr/bin/flock --exclusive --timeout 21600 --conflict-exit-code 75 /home/ec2-user/data-collection-processing/.heavy-job.lock /usr/bin/timeout --signal=INT --kill-after=60s 20m /home/ec2-user/data-collection-processing/.venv-athena/bin/python -B /home/ec2-user/data-collection-processing/product_search_daily.py
TimeoutStartSec=7h
TimeoutStopSec=90
KillSignal=SIGINT
SuccessExitStatus=0 2 75
Nice=15
NoNewPrivileges=true
ProtectSystem=full
