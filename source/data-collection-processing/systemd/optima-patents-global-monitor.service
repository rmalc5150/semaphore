[Unit]
Description=Observe global patent source revision without executing BigQuery queries
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/home/ec2-user/data-collection-processing
ExecStart=/home/ec2-user/data-collection-processing/.venv-athena/bin/python -B /home/ec2-user/data-collection-processing/patent_operations.py monitor-global
TimeoutStartSec=5min
Nice=10
