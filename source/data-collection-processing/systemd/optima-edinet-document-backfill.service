[Unit]
Description=EDINET original reports, Japanese extraction and company linkage backfill
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/home/ec2-user/data-collection-processing
Slice=optima-data.slice
MemoryAccounting=true
MemoryHigh=402653184
MemoryMax=536870912
MemorySwapMax=0
CPUQuota=40%
Environment=MALLOC_ARENA_MAX=2
ExecStart=/usr/bin/timeout --signal=INT --kill-after=60s 20m /home/ec2-user/data-collection-processing/.venv-athena/bin/python -B /home/ec2-user/data-collection-processing/edinet_backfill.py
TimeoutStartSec=22min
TimeoutStopSec=90
KillSignal=SIGINT
SuccessExitStatus=0 2 124
Nice=15
NoNewPrivileges=true
ProtectSystem=full

