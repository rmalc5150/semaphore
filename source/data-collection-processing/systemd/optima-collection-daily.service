[Unit]
Description=Optima migrated daily collectors with catch-up and reconciliation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/home/ec2-user/data-collection-processing
ExecStart=/home/ec2-user/data-collection-processing/.venv-athena/bin/python -B /home/ec2-user/data-collection-processing/collect_daily.py --max-windows 5 --reconcile-days 3
TimeoutStartSec=6h
TimeoutStopSec=120
KillSignal=SIGINT
Nice=10

