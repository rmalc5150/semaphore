[Unit]
Description=Publish the verified metadata counts used by the overview and daily digest
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/home/ec2-user/data-collection-processing
Environment=AWS_CONFIG_FILE=/dev/null AWS_SHARED_CREDENTIALS_FILE=/dev/null AWS_DEFAULT_REGION=us-east-1 AWS_REGION=us-east-1 AWS_EC2_METADATA_DISABLED=false
ExecStart=/home/ec2-user/data-collection-processing/.venv-athena/bin/python -B /home/ec2-user/data-collection-processing/metadata_publication_report.py
NoNewPrivileges=true
ProtectSystem=full
TimeoutStartSec=20min
MemoryHigh=128M
MemoryMax=256M
CPUQuota=30%
Nice=15
