[Unit]
Description=Optima verified proceedings Athena publication
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/home/ec2-user/data-collection-processing
ExecStart=/home/ec2-user/data-collection-processing/.venv-athena/bin/python -B /home/ec2-user/data-collection-processing/conference_athena.py
SuccessExitStatus=2
TimeoutStartSec=45min
TimeoutStopSec=120
KillSignal=SIGINT
Nice=15
MemoryAccounting=true
MemoryHigh=512M
MemoryMax=768M
MemorySwapMax=0
Environment=ARROW_NUM_THREADS=1
Environment=MALLOC_ARENA_MAX=2
