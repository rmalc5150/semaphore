[Unit]
Description=Refresh EODHD global common-stock inventory directly in S3
After=network-online.target optima-s3-runtime-init.service
Wants=network-online.target
Requires=optima-s3-runtime-init.service
[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/home/ec2-user/data-collection-processing
Slice=optima-data.slice
ExecStart=/usr/bin/flock --exclusive --timeout 43200 --conflict-exit-code 75 /dev/shm/optima-s3/supervisor.lock /home/ec2-user/data-collection-processing/.venv-athena/bin/python -B /home/ec2-user/data-collection-processing/s3_runtime.py --unit optima-eodhd-inventory.service -- /usr/bin/timeout --signal=INT --kill-after=120s 45m /home/ec2-user/data-collection-processing/.venv-athena/bin/python -B /home/ec2-user/data-collection-processing/eodhd_inventory_daily.py
ProtectSystem=strict
ReadOnlyPaths=/home/ec2-user /tmp /var/tmp /dev/shm
ReadWritePaths=/dev/shm/optima-s3
PrivateTmp=false
Environment=PYTHONDONTWRITEBYTECODE=1
MemoryHigh=1700000000
MemoryMax=1900000000
MemorySwapMax=0
TimeoutStartSec=13h
TimeoutStopSec=240
KillMode=mixed
KillSignal=SIGINT
SuccessExitStatus=0 2 75
Nice=10
[Install]
WantedBy=multi-user.target
