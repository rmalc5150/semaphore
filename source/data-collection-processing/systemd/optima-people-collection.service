[Unit]
Description=Optima bounded four-sector personnel source collection and archive retrieval
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/home/ec2-user/data-collection-processing
ExecStart=/home/ec2-user/data-collection-processing/.venv-athena/bin/python -B /home/ec2-user/data-collection-processing/people_collection_operations.py
TimeoutStartSec=45min
TimeoutStopSec=120
KillSignal=SIGINT
Nice=15
