[Unit]
Description=Optima bounded fixed-query weekly search capture and verified publication
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/home/ec2-user/data-collection-processing
Slice=optima-data.slice
MemoryAccounting=true
MemoryHigh=201326592
MemoryMax=268435456
MemorySwapMax=0
Environment=ARROW_NUM_THREADS=1
Environment=MALLOC_ARENA_MAX=2
ExecStart=/usr/bin/flock --exclusive --timeout 21600 --conflict-exit-code 75 /home/ec2-user/data-collection-processing/.heavy-job.lock /usr/bin/timeout --signal=INT --kill-after=120s 20m /home/ec2-user/data-collection-processing/.venv-athena/bin/python -B /home/ec2-user/data-collection-processing/readiness_recurring.py
TimeoutStartSec=7h
TimeoutStopSec=120
KillSignal=SIGINT
SuccessExitStatus=75
Nice=15

