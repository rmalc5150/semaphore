[Unit]
Description=Bounded authenticated FDA EDINET EIA historical collection and publication
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/home/ec2-user/data-collection-processing
Slice=optima-data.slice
MemoryHigh=167772160
MemoryMax=201326592
MemorySwapMax=0
Environment=ARROW_NUM_THREADS=1
Environment=MALLOC_ARENA_MAX=2
ExecStart=/usr/bin/timeout --signal=INT --kill-after=120s 20m /home/ec2-user/data-collection-processing/.venv-athena/bin/python -B /home/ec2-user/data-collection-processing/specialist_inputs.py --lane authenticated --mode historical --max-jobs 12 --pages 2 --publish 0
TimeoutStartSec=25min
TimeoutStopSec=120
KillSignal=SIGINT
SuccessExitStatus=75
Nice=15
