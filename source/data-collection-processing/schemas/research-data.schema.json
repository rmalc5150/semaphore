        }
      },
      "required": [
        "product_id",
        "canonical_name",
        "product_type",
        "aliases",
        "observed_at",
        "review_status",
        "evidence"
      ]
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
