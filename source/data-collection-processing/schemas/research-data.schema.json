    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "document_type": {
          "const": "sector_taxonomy"
        },
        "schema_version": {
          "const": "1.0"
        },
        "taxonomy_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "sectors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sector_id": {
                "enum": [
                  "biotech",
                  "robotics",
                  "semiconductors",
                  "energy_storage"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "subsectors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "subsector_id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "subsector_id",
                    "name"
                  ]
                },
                "minItems": 1
              }
            },
