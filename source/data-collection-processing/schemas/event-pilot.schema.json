{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Event pilot candidate; not production event contract",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "event_version_id",
    "event_type",
    "summary",
    "status",
    "review_status",
    "match_key",
    "occurrence",
    "classifications",
    "specialist_routes",
    "evidence",
    "point_in_time_eligible",
    "model_outputs"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "event_id": {
      "type": "string",
      "pattern": "^test_evt_[0-9a-f]{64}$"
    },
    "event_version_id": {
      "type": "string",
      "pattern": "^test_ver_[0-9a-f]{64}$"
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z_]+\\.[a-z_]+$"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "candidate"
    },
    "review_status": {
      "const": "pending"
    },
    "point_in_time_eligible": {
      "const": false
    },
    "model_outputs": {
      "type": "null"
    },
    "match_key": {
      "type": "object",
      "required": [
        "namespace",
        "value"
      ]
    },
    "occurrence": {
      "type": [
        "object",
        "null"
      ]
    },
    "classifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sector_id",
          "subsector_id",
          "status",
          "basis"
        ],
        "properties": {
          "status": {
            "const": "candidate"
          },
          "subsector_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "specialist_routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "status",
          "specialist_id",
          "basis"
        ],
        "properties": {
          "status": {
            "const": "proposed"
          },
          "specialist_id": {
            "type": "null"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "observation_id",
          "source",
          "dataset",
          "source_id",
          "supporting_fields",
          "provenance"
        ],
        "properties": {
          "supporting_fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "path",
                "value"
              ]
            }
          }
        }
      }
    }
  }
}
